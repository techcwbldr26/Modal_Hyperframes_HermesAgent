# Modal authentication — prefer local ~/.modal.toml (already configured). Set only for CI/CD.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# Hugging Face token (optional local mirror of the Modal secret "huggingface-token")
HF_TOKEN=

# Modal MCP server behavior (used by Hermes MCP config, not this repo's .env)
MODAL_MCP_READ_ONLY=false
MODAL_MCP_ENABLED_TOOLSETS=discovery,apps,functions,volumes,storage,secrets,servers,containers,workspace

# Model + endpoint
MODEL_REPO=Qwen/Qwen3.8-27B
# Fill after Task 5 deploy: https://<workspace>--qwen38-serve.modal.run/v1
QWEN_BASE_URL=

# Official Qwen3.8-27B thinking-mode sampling defaults (model card, Aug 2026)
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPETITION_PENALTY=1.0
REASONING_EFFORT=xhigh
